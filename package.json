{
  "name": "pi-chrome-connector",
  "version": "0.1.1",
  "description": "Agent-first Chrome connector for pi: drive your real Chrome (tabs, keyboard and mouse, screenshots, console, network, request mocking) through a companion extension.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "chrome",
    "chrome-extension",
    "browser",
    "browser-automation",
    "devtools",
    "cdp",
    "screenshot"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Akshay Patel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akshay-patel7/pi-chrome-connector.git"
  },
  "bugs": {
    "url": "https://github.com/Akshay-patel7/pi-chrome-connector/issues"
  },
  "homepage": "https://github.com/Akshay-patel7/pi-chrome-connector#readme",
  "files": [
    "extensions/",
    "chrome-extension/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/chrome/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/unit/**/*.test.ts'",
    "test:integration": "node --test --test-concurrency=1 'test/integration/**/*.test.ts'",
    "test:all": "npm run typecheck && npm test && npm run test:integration",
    "prepublishOnly": "npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@types/node": "24.13.6",
    "devtools-protocol": "0.0.1701330",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
